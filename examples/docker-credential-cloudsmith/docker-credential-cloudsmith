#!/usr/bin/env python3
"""
Docker Credential Helper for Cloudsmith

This credential helper integrates with Docker to provide automatic authentication
to Cloudsmith Docker registries using the `cloudsmith tokens get` command.

Installation:
    1. Make this script executable: chmod +x docker-credential-cloudsmith
    2. Move to PATH: sudo mv docker-credential-cloudsmith /usr/local/bin/
    3. Configure Docker (~/.docker/config.json):
       {
         "credsStore": "cloudsmith"
       }
       
       Or for specific registries:
       {
         "credHelpers": {
           "docker.cloudsmith.io": "cloudsmith"
         }
       }

Usage:
    Docker will automatically call this helper when pulling/pushing to
    Cloudsmith registries.

Environment Variables:
    CLOUDSMITH_OIDC_SLUG: Organization slug for OIDC authentication (optional)
    CLOUDSMITH_API_KEY: API key for authentication (optional, fallback)

Reference:
    https://docs.docker.com/engine/reference/commandline/login/#credential-helpers
    https://github.com/awslabs/amazon-ecr-credential-helper
"""

import json
import os
import subprocess
import sys


def get_cloudsmith_token(server_url):
    """
    Get authentication token from Cloudsmith CLI.
    
    Args:
        server_url: The Docker registry server URL
        
    Returns:
        str: The authentication token
        
    Raises:
        Exception: If token retrieval fails
    """
    # Check if this is a Cloudsmith registry
    if "cloudsmith.io" not in server_url:
        raise Exception(f"Not a Cloudsmith registry: {server_url}")
    
    # Build the command
    cmd = ["cloudsmith", "tokens", "get"]
    
    # Add OIDC slug if provided
    oidc_slug = os.environ.get("CLOUDSMITH_OIDC_SLUG")
    if oidc_slug:
        cmd.extend(["--oidc-slug", oidc_slug])
    
    try:
        # Execute the command
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            check=True
        )
        token = result.stdout.strip()
        
        if not token:
            raise Exception("Empty token received from cloudsmith tokens get")
            
        return token
        
    except subprocess.CalledProcessError as e:
        raise Exception(f"Failed to get token: {e.stderr}")
    except FileNotFoundError:
        raise Exception(
            "cloudsmith CLI not found. Please install: pip install cloudsmith-cli"
        )


def docker_credential_get(server_url):
    """
    Get credentials for the specified server.
    
    This is called by Docker when it needs credentials for a registry.
    
    Args:
        server_url: The Docker registry server URL
        
    Returns:
        dict: Credentials in Docker credential helper format
    """
    try:
        token = get_cloudsmith_token(server_url)
        
        # Docker expects credentials in this format
        # For Cloudsmith, username is "token" and password is the actual token
        return {
            "ServerURL": server_url,
            "Username": "token",
            "Secret": token
        }
    except Exception as e:
        # Return error in Docker credential helper format
        return {
            "ServerURL": server_url,
            "Username": "",
            "Secret": "",
            "Error": str(e)
        }


def docker_credential_store(credentials):
    """
    Store credentials (not implemented - Cloudsmith tokens are fetched on-demand).
    
    Args:
        credentials: Credentials to store
    """
    # We don't store credentials, they're fetched on-demand
    # Return success to satisfy Docker
    pass


def docker_credential_erase(server_url):
    """
    Erase credentials (not implemented - Cloudsmith tokens are fetched on-demand).
    
    Args:
        server_url: The server URL to erase credentials for
    """
    # We don't store credentials, they're fetched on-demand
    # Return success to satisfy Docker
    pass


def docker_credential_list():
    """
    List stored credentials (not implemented - Cloudsmith tokens are fetched on-demand).
    
    Returns:
        dict: Empty dictionary (no stored credentials)
    """
    # We don't store credentials, return empty list
    return {}


def main():
    """Main entry point for the Docker credential helper."""
    if len(sys.argv) < 2:
        print("Usage: docker-credential-cloudsmith <get|store|erase|list>", file=sys.stderr)
        sys.exit(1)
    
    command = sys.argv[1]
    
    try:
        if command == "get":
            # Read server URL from stdin
            server_url = sys.stdin.read().strip()
            result = docker_credential_get(server_url)
            print(json.dumps(result))
            
        elif command == "store":
            # Read credentials from stdin (but don't actually store them)
            credentials = json.loads(sys.stdin.read())
            docker_credential_store(credentials)
            
        elif command == "erase":
            # Read server URL from stdin (but don't actually erase anything)
            server_url = sys.stdin.read().strip()
            docker_credential_erase(server_url)
            
        elif command == "list":
            # Return empty list
            result = docker_credential_list()
            print(json.dumps(result))
            
        else:
            print(f"Unknown command: {command}", file=sys.stderr)
            sys.exit(1)
            
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
