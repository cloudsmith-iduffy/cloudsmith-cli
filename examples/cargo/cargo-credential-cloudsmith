#!/usr/bin/env bash
# Cargo Credential Provider for Cloudsmith
#
# This script provides credentials for Cargo/Rust registries on Cloudsmith.
# It implements the Cargo credential provider protocol (Cargo 1.68+).
#
# Installation:
#   chmod +x cargo-credential-cloudsmith
#   sudo cp cargo-credential-cloudsmith /usr/local/bin/
#
# Configuration (~/.cargo/config.toml):
#   [registries.cloudsmith]
#   index = "sparse+https://cargo.cloudsmith.io/my-org/my-repo/"
#   credential-provider = "cloudsmith"

case "$1" in
  get)
    # Get the registry information from stdin (JSON format)
    # For simplicity, we'll get the token regardless of registry
    
    if [ -n "$CLOUDSMITH_OIDC_SLUG" ]; then
      TOKEN=$(cloudsmith tokens get --oidc-slug "$CLOUDSMITH_OIDC_SLUG")
    else
      TOKEN=$(cloudsmith tokens get)
    fi
    
    if [ -z "$TOKEN" ]; then
      echo '{"Err":{"kind":"other","message":"Failed to get Cloudsmith token"}}'
      exit 1
    fi
    
    # Return in Cargo credential provider format
    echo "{\"Ok\":{\"kind\":\"token\",\"token\":\"$TOKEN\",\"cache\":\"session\"}}"
    ;;
    
  login)
    # Login not needed - we fetch tokens on demand
    echo '{"Ok":{"kind":"login-not-needed"}}'
    ;;
    
  logout)
    # Logout not needed - we don't store credentials
    echo '{"Ok":null}'
    ;;
    
  store)
    # Store not needed - we fetch tokens on demand
    echo '{"Ok":null}'
    ;;
    
  erase)
    # Erase not needed - we don't store credentials
    echo '{"Ok":null}'
    ;;
    
  *)
    echo "{\"Err\":{\"kind\":\"unsupported-command\",\"message\":\"Unknown command: $1\"}}"
    exit 1
    ;;
esac
