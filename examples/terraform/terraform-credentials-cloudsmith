#!/bin/bash
# Terraform Credential Helper for Cloudsmith
#
# This credential helper integrates with Terraform's credentials helper protocol
# to provide automatic authentication for Cloudsmith Terraform registries.
#
# Protocol: https://developer.hashicorp.com/terraform/internals/credentials-helpers

set -e

# Parse arguments
if [ $# -lt 2 ]; then
    echo "Usage: terraform-credentials-cloudsmith {get|store|forget} <hostname>" >&2
    exit 1
fi

VERB="$1"
HOSTNAME="$2"
OIDC_SLUG=""

# Check for --oidc-slug in remaining args
shift 2
while [[ $# -gt 0 ]]; do
    case $1 in
        --oidc-slug=*)
            OIDC_SLUG="${1#*=}"
            shift
            ;;
        --oidc-slug)
            OIDC_SLUG="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Check if OIDC slug is in environment
if [ -z "$OIDC_SLUG" ] && [ -n "$CLOUDSMITH_OIDC_SLUG" ]; then
    OIDC_SLUG="$CLOUDSMITH_OIDC_SLUG"
fi

case "$VERB" in
    get)
        # Check if this is a Cloudsmith hostname
        if [[ "$HOSTNAME" != *"cloudsmith.io"* ]]; then
            echo "{}" # Return empty JSON for non-Cloudsmith hosts
            exit 0
        fi
        
        # Get token from cloudsmith CLI
        if [ -n "$OIDC_SLUG" ]; then
            TOKEN=$(cloudsmith tokens get --oidc-slug "$OIDC_SLUG" 2>/dev/null)
        else
            TOKEN=$(cloudsmith tokens get 2>/dev/null)
        fi
        
        if [ -z "$TOKEN" ]; then
            echo '{"error": "Failed to get Cloudsmith token"}' >&2
            exit 1
        fi
        
        # Return token in Terraform format
        echo "{\"token\": \"$TOKEN\"}"
        ;;
        
    store)
        # Terraform wants to store credentials - we don't need to do anything
        # since we fetch them dynamically
        exit 0
        ;;
        
    forget)
        # Terraform wants to forget credentials - no-op for dynamic fetching
        exit 0
        ;;
        
    *)
        echo "Unknown verb: $VERB" >&2
        echo "Usage: terraform-credentials-cloudsmith {get|store|forget} <hostname>" >&2
        exit 1
        ;;
esac
