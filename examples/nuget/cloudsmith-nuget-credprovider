#!/usr/bin/env python3
"""
NuGet Credential Provider for Cloudsmith

This credential provider integrates with NuGet's plugin protocol to provide
automatic authentication for Cloudsmith NuGet feeds using `cloudsmith tokens get`.
"""

import json
import os
import subprocess
import sys
from urllib.parse import urlparse


def get_cloudsmith_token(oidc_slug=None):
    """Get Cloudsmith token using cloudsmith CLI."""
    cmd = ["cloudsmith", "tokens", "get"]
    
    if oidc_slug:
        cmd.extend(["--oidc-slug", oidc_slug])
    
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            check=True,
            timeout=30
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error getting token: {e.stderr}", file=sys.stderr)
        return None
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return None


def is_cloudsmith_url(url):
    """Check if URL is a Cloudsmith NuGet feed."""
    parsed = urlparse(url)
    return "cloudsmith.io" in parsed.netloc


def handle_get_authentication_credentials(uri, is_retry, is_non_interactive, can_show_dialog):
    """Handle GetAuthenticationCredentials request from NuGet."""
    
    if not is_cloudsmith_url(uri):
        return {
            "ResponseCode": "NotApplicable",
            "Message": "Not a Cloudsmith URL"
        }
    
    # Get OIDC slug from environment
    oidc_slug = os.environ.get("CLOUDSMITH_OIDC_SLUG")
    
    # Get token
    token = get_cloudsmith_token(oidc_slug)
    
    if not token:
        return {
            "ResponseCode": "Failure",
            "Message": "Failed to get Cloudsmith token"
        }
    
    return {
        "ResponseCode": "Success",
        "Username": "token",
        "Password": token
    }


def main():
    """Main entry point for NuGet credential provider plugin."""
    
    if len(sys.argv) < 2:
        print("Usage: cloudsmith-nuget-credprovider <operation>", file=sys.stderr)
        sys.exit(1)
    
    operation = sys.argv[1]
    
    if operation == "-GetOperationClaims":
        # Return supported operations
        response = {
            "ResponseCode": "Success",
            "OperationClaims": ["GetAuthenticationCredentials"]
        }
        print(json.dumps(response))
        sys.exit(0)
    
    elif operation == "-GetAuthenticationCredentials":
        # Parse arguments
        uri = None
        is_retry = False
        is_non_interactive = False
        can_show_dialog = False
        
        i = 2
        while i < len(sys.argv):
            arg = sys.argv[i]
            if arg == "-Uri" and i + 1 < len(sys.argv):
                uri = sys.argv[i + 1]
                i += 2
            elif arg == "-IsRetry" and i + 1 < len(sys.argv):
                is_retry = sys.argv[i + 1].lower() == "true"
                i += 2
            elif arg == "-NonInteractive" and i + 1 < len(sys.argv):
                is_non_interactive = sys.argv[i + 1].lower() == "true"
                i += 2
            elif arg == "-CanShowDialog" and i + 1 < len(sys.argv):
                can_show_dialog = sys.argv[i + 1].lower() == "true"
                i += 2
            else:
                i += 1
        
        if not uri:
            response = {
                "ResponseCode": "Failure",
                "Message": "No URI provided"
            }
        else:
            response = handle_get_authentication_credentials(
                uri, is_retry, is_non_interactive, can_show_dialog
            )
        
        print(json.dumps(response))
        sys.exit(0)
    
    else:
        print(f"Unknown operation: {operation}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
